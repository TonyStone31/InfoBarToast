<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="InfoBarToast"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Tony Stone"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="src"/>
        <OtherUnitFiles Value="src"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="TInfoBar: a strip over the edge of a form or control that stays until answered. TToast: a short message that slides in and goes by itself. Plain LCL."/>
    <License Value="0BSD"/>
    <Version Major="1"/>
    <Files Count="3">
      <Item1>
        <Filename Value="src/infobar.pas"/>
        <UnitName Value="InfoBar"/>
      </Item1>
      <Item2>
        <Filename Value="src/toast.pas"/>
        <UnitName Value="Toast"/>
      </Item2>
      <Item3>
        <Filename Value="src/infobartoastreg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="InfoBarToastReg"/>
      </Item3>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="LCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
